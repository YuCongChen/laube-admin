{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "@laube/starter": "<rootDir>/../libs/starter/src",
    "@laube/starter/(.*)": "<rootDir>/../libs/starter/src/$1"
  }
}